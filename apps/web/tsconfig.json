{
  "extends": "@sina-design-system/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    // Apps emit no declarations; disabling this avoids TS2742 declaration-
    // portability errors on build-config exports (e.g. fumadocs `defineDocs`,
    // whose inferred type references fumadocs-mdx's bundled zod v4).
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
