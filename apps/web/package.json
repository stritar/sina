{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "description": "SINA marketing site + docs. Fumadocs (headless) docs, bespoke landing. Never published to npm.",
  "scripts": {
    "predev": "node scripts/generate-llms.mjs",
    "dev": "next dev --port 3000",
    "generate:llms": "node scripts/generate-llms.mjs",
    "prebuild": "pnpm exec turbo run build --filter=web^... && node scripts/generate-llms.mjs",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf .next .source",
    "postinstall": "fumadocs-mdx",
    "pages:build": "pnpm exec turbo run build --filter=web^... && next-on-pages",
    "pages:preview": "wrangler pages dev .vercel/output/static --compatibility-flags=nodejs_compat"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@sina-design-system/core": "workspace:*",
    "@sina-design-system/fintech": "workspace:*",
    "@sina-design-system/fintech-react": "workspace:*",
    "@sina-design-system/governance": "workspace:*",
    "@sina-design-system/governance-demo": "workspace:*",
    "@sina-design-system/theme": "workspace:*",
    "fumadocs-core": "15.8.5",
    "fumadocs-mdx": "14.2.13",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simplex-noise": "^4.0.3"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.12",
    "@sina-design-system/config": "workspace:*",
    "@testing-library/user-event": "^14.5.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "wrangler": "^3.114.1"
  }
}
