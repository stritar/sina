{
  "name": "@sina-design-system/fintech-react",
  "version": "0.1.0",
  "description": "SINA governed fintech components — core primitives composed with the fintech constitution. The gate is server-side; these render the decision.",
  "license": "MIT",
  "author": "Denis Stritar",
  "keywords": [
    "sina",
    "design-system",
    "react",
    "fintech",
    "governance",
    "governed-components"
  ],
  "homepage": "https://github.com/stritar/sina#readme",
  "bugs": "https://github.com/stritar/sina/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stritar/sina.git",
    "directory": "packages/fintech-react"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@sina-design-system/core": "workspace:*",
    "@sina-design-system/fintech": "workspace:*",
    "@sina-design-system/governance": "workspace:*",
    "@sina-design-system/theme": "workspace:*",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@sina-design-system/config": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "jest-axe": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "rollup-preserve-directives": "^1.1.3",
    "typescript": "^5.7.3",
    "vite": "^5.4.0",
    "vitest-canvas-mock": "^0.3.3"
  }
}
